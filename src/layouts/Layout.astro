  <!-- ═══════════════════════════════════════ -->
  <!-- CLIENT-SIDE JAVASCRIPT                  -->
  <!-- ═══════════════════════════════════════ -->
  <script is:inline>
    // ── Page transitions ──────────────────────
    document.querySelectorAll('a[href]').forEach(a => {
      const href = a.getAttribute('href');
      if (href && !href.startsWith('http') && !href.startsWith('#')
               && !href.startsWith('mailto') && !href.startsWith('tel')
               && !a.classList.contains('glightbox')
               && !a.classList.contains('glightbox-tienda')
               && !a.classList.contains('glightbox-coverup')) {
        a.addEventListener('click', e => {
          e.preventDefault();
          document.body.classList.add('page-leaving');
          setTimeout(() => { window.location.href = href; }, 260);
        });
      }
    });

    // ── Active nav link ───────────────────────
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('.nb-link, .mob-link').forEach(link => {
      const href = (link.getAttribute('href') || '').replace(/\/$/, '') || '/';
      if (href === currentPath) link.classList.add('active');
    });

    // hero slideshow handled in index.astro

    // ── Navbar scroll ─────────────────────────
    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      navbar.classList.toggle('scrolled', window.scrollY > 40);
    }, { passive: true });

    // ── Scroll to top ─────────────────────────
    const scrollTopBtn = document.getElementById('scroll-top');
    window.addEventListener('scroll', () => {
      scrollTopBtn.classList.toggle('visible', window.scrollY > 400);
    }, { passive: true });

    // ── Mobile menu ───────────────────────────
    const mobileMenu = document.getElementById('mob-menu');
    function applyMobActive() {
      const path = window.location.pathname.replace(/\/$/, '') || '/';
      document.querySelectorAll('.mob-link').forEach(function(link) {
        const href = (link.getAttribute('href') || '').replace(/\/$/, '') || '/';
        link.classList.toggle('active', href === path);
      });
    }
    function openMobileMenu()  { mobileMenu.classList.add('open');    document.body.style.overflow = 'hidden'; applyMobActive(); }
    function closeMobileMenu() { mobileMenu.classList.remove('open'); document.body.style.overflow = ''; }

    // ── Scroll reveal ─────────────────────────
    const revealEls = document.querySelectorAll('.reveal, .reveal-left, .reveal-right');
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('visible'); revealObserver.unobserve(entry.target); }
      });
    }, { threshold: 0.12 });
    revealEls.forEach(el => revealObserver.observe(el));

    // ── Form submit → WhatsApp ────────────────
    function handleSubmit(e) {
      e.preventDefault();
      const data    = new FormData(e.target);
      const nombre  = data.get('nombre') || '';
      const idea    = data.get('idea')   || '';
      const t       = (typeof i18n !== 'undefined' && i18n[currentLang]) ? i18n[currentLang] : i18n['es'];
      const intro   = t.wa_form_intro   || 'Hola Wayki Tattoo! Soy';
      const ideaKey = t.wa_form_idea    || 'Mi idea:';
      const consult = t.wa_form_consult || 'Quiero consultar sobre una cita.';
      const msg     = encodeURIComponent(
        `${intro} ${nombre}. ${idea ? ideaKey + ' ' + idea : consult}`
      );
      window.open(`https://wa.me/51993054099?text=${msg}`, '_blank');
      const success = document.getElementById('form-success');
      if (success) success.style.display = 'block';
      e.target.reset();
    }

    // ── i18n engine ───────────────────────────
    let currentLang = localStorage.getItem('wayki-lang') || 'es';

    function applyLang() {
      const t = (typeof i18n !== 'undefined' && i18n[currentLang]) ? i18n[currentLang] : null;
      if (!t) return;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.dataset.i18n;
        if (t[key] === undefined) return;
        let val = t[key];
        if (val.startsWith && val.startsWith('/')) val = val.slice(1);
        el.innerHTML = val;
      });
      document.querySelectorAll('[data-i18n-ph]').forEach(el => {
        const key = el.dataset.i18nPh;
        if (t[key] !== undefined) el.placeholder = t[key];
      });
      // WhatsApp links — mensajes estáticos
      document.querySelectorAll('[data-wa-msg]').forEach(el => {
        const key = el.dataset.waMsg;
        if (t[key]) el.href = 'https://wa.me/51993054099?text=' + encodeURIComponent(t[key]);
      });
      // WhatsApp links — prefijo + nombre de producto/artista
      document.querySelectorAll('[data-wa-prefix]').forEach(el => {
        const key    = el.dataset.waPrefix;
        const suffix = el.dataset.waSuffix || '';
        if (t[key]) el.href = 'https://wa.me/51993054099?text=' + encodeURIComponent(t[key] + suffix);
      });
      document.documentElement.lang = currentLang;
      document.querySelectorAll('.lang-opt').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.lang === currentLang);
      });
      const label = document.getElementById('lang-current');
      if (label) label.textContent = currentLang.toUpperCase();
      const labelMobile = document.getElementById('lang-mobile-current');
      if (labelMobile) labelMobile.textContent = currentLang.toUpperCase();
    }

    function setLang(lang) {
      currentLang = lang;
      localStorage.setItem('wayki-lang', lang);
      applyLang();
      const menu    = document.getElementById('lang-menu');
      const mobMenu = document.getElementById('mob-lang-menu');
      if (menu)    menu.style.display    = 'none';
      if (mobMenu) mobMenu.style.display = 'none';
    }

    function toggleLangMenu() {
      const menu = document.getElementById('lang-menu');
      if (!menu) return;
      menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
    }

    function toggleMobLangMenu() {
      const menu = document.getElementById('mob-lang-menu');
      if (!menu) return;
      menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
    }

    // Close lang dropdowns on outside click
    document.addEventListener('click', (e) => {
      const wrap = document.getElementById('nb-lang-wrap');
      const menu = document.getElementById('lang-menu');
      if (menu && wrap && !wrap.contains(e.target)) menu.style.display = 'none';
      const mobBtn  = document.getElementById('nb-lang-mob');
      const mobMenu = document.getElementById('mob-lang-menu');
      if (mobMenu && mobBtn && !mobBtn.closest('div').contains(e.target)) mobMenu.style.display = 'none';
    });

    const mobileLangLabel = document.getElementById('lang-mobile-current');
    if (mobileLangLabel) mobileLangLabel.textContent = currentLang.toUpperCase();

    applyLang();
  </script>
