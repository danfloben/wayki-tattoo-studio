---
export interface Props {
  title:       string;
  description: string;
  url:         string;
  image?:      string;
}

const {
  title,
  description,
  url,
  image = 'https://waykitattoostudio.pe/images/facebook_cover.jpg',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO Primary -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content="tatuajes arequipa, tattoo studio peru, wayki tattoo, realismo tatuaje, piercing arequipa, sivola ink" />
  <meta name="author" content="Wayki Tattoo Studio" />
  <link rel="canonical" href={url} />

  <!-- Open Graph / Facebook -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={url} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={image} />
  <meta property="og:image:width"  content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale"      content="es_PE" />
  <meta property="og:site_name"   content="Wayki Tattoo Studio" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:url"         content={url} />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={image} />

  <!-- Robots -->
  <meta name="robots" content="index, follow" />

  <!-- Structured Data: LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "TattooParlor",
    "name": "Wayki Tattoo Studio",
    "image": "https://waykitattoostudio.pe/images/studio.webp",
    "url": "https://waykitattoostudio.pe",
    "telephone": "+51-993-054-099",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Calle Campo Redondo 100, Cercado",
      "addressLocality": "Arequipa",
      "addressCountry": "PE"
    },
    "sameAs": [
      "https://www.instagram.com/waykitattoostudio/",
      "https://www.facebook.com/waykitattoostudio"
    ]
  }
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=4" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Translations & Tailwind -->
  <script is:inline src="/translations.js"></script>
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <script is:inline>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            'brand-black':   '#0d0f0f',
            'brand-dark':    '#121414',
            'brand-surface': '#1a1c1c',
            'brand-card':    '#1e2020',
            'brand-border':  '#2a2d2d',
            'brand-red':     '#be0000',
            'brand-red-deep':'#930000',
            'brand-red-glow':'rgba(190,0,0,0.35)',
            'brand-text':    '#e2e2e2',
            'brand-muted':   '#a0a0a0',
            'brand-accent':  '#ffb4a8',
          },
          fontFamily: {
            headline: ['Space Grotesk', 'sans-serif'],
            body:     ['Manrope', 'sans-serif'],
            mono:     ['JetBrains Mono', 'monospace'],
          },
        }
      }
    }
  </script>

  <style is:global>
    /* ── Base ─────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; }
    html { font-family: 'Manrope', sans-serif; }
    body { background: #0d0f0f; color: #e2e2e2; overflow-x: hidden; }

    /* ── Noise grain overlay ──────────────── */
    .noise::after {
      content: '';
      position: fixed; inset: 0;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
      opacity: 0.028; pointer-events: none; z-index: 9999;
    }

    /* ── Ink-bleed section divider ────────── */
    .ink-divider {
      width: 100%; height: 120px; margin-top: -60px;
      background: radial-gradient(ellipse 80% 60% at 50% 100%, #be0000 0%, transparent 70%);
      opacity: 0.12; pointer-events: none;
    }

    /* ── Scroll-reveal ────────────────────── */
    .reveal { opacity: 0; transform: translateY(32px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-left  { opacity: 0; transform: translateX(-40px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal-right { opacity: 0; transform: translateX(40px);  transition: opacity 0.7s ease, transform 0.7s ease; }
    .reveal-left.visible, .reveal-right.visible { opacity: 1; transform: translateX(0); }

    /* ── Page transitions ─────────────────── */
    @keyframes pageIn { from { opacity: 0; } to { opacity: 1; } }
    body { animation: pageIn 0.35s ease forwards; }
    body.page-leaving { opacity: 0; transition: opacity 0.26s ease; }

    /* ── Nav ──────────────────────────────── */
    #navbar { transition: transform 0.3s ease, background 0.3s, backdrop-filter 0.3s, box-shadow 0.3s; }
    #navbar.scrolled { background: rgba(13,15,15,0.95); backdrop-filter: blur(16px); box-shadow: 0 1px 0 rgba(190,0,0,0.2); }

    /* ── Hero ─────────────────────────────── */
    .hero-bg { background: #0d0f0f; }

    /* ── CTA Buttons ──────────────────────── */
    .btn-primary {
      display: inline-flex; align-items: center; gap: 8px;
      background: #be0000; color: #fff; padding: 14px 36px;
      font-family: 'Space Grotesk', sans-serif; font-weight: 700;
      font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
      border: none;
      transition: background 0.2s, transform 0.15s;
      cursor: pointer; text-decoration: none;
    }
    .btn-primary:hover { background: #930000; transform: translateY(-1px); }
    .btn-primary:active { transform: scale(0.97); }
    .btn-ghost {
      display: inline-flex; align-items: center; gap: 8px;
      background: #111313; color: #fff; padding: 14px 36px;
      font-family: 'Space Grotesk', sans-serif; font-weight: 700;
      font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase;
      border: none;
      transition: background 0.2s, transform 0.15s;
      cursor: pointer; text-decoration: none;
    }
    .btn-ghost:hover { background: #1e2020; transform: translateY(-1px); }
    .btn-ghost:active { transform: scale(0.97); }

    /* ── Category circles ─────────────────── */
    .cat-circle {
      width: 64px; height: 64px; border-radius: 50%;
      background: radial-gradient(circle at 40% 35%, #3a0000, #1a1c1c);
      border: 1.5px solid #2a2d2d;
      display: flex; align-items: center; justify-content: center;
      transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s; cursor: pointer;
    }
    .cat-circle:hover { border-color: #be0000; transform: translateY(-4px); box-shadow: 0 8px 24px rgba(190,0,0,0.3); }
    .cat-circle svg { width: 26px; height: 26px; }

    /* ── Portfolio cards ──────────────────── */
    .port-card { overflow: hidden; border: 1px solid #2a2d2d; position: relative; cursor: pointer; }
    .port-card img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(30%); transition: transform 0.6s ease, filter 0.6s ease; display: block; }
    .port-card:hover img { transform: scale(1.06); filter: grayscale(0%); }
    .port-card .port-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(190,0,0,0.6) 0%, transparent 50%);
      opacity: 0; transition: opacity 0.4s ease;
      display: flex; align-items: flex-end; padding: 16px;
    }
    .port-card:hover .port-overlay { opacity: 1; }
    .port-label { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #fff; background: rgba(0,0,0,0.6); padding: 5px 10px; }

    /* ── Service cards ────────────────────── */
    .svc-card { background: #1a1c1c; border: 1px solid #2a2d2d; padding: 28px 24px; transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s; }
    .svc-card:hover { border-color: #be0000; transform: translateY(-4px); box-shadow: 0 12px 32px rgba(190,0,0,0.15); }
    .svc-icon { width: 32px; height: 32px; background: radial-gradient(circle at 40% 35%, #3a0000, #1a1c1c); border: 1px solid #3a0000; display: flex; align-items: center; justify-content: center; margin-bottom: 14px; }
    .svc-icon svg { width: 15px; height: 15px; fill: #be0000; }

    /* ── Stats ────────────────────────────── */
    .stat-num { font-family: 'Space Grotesk', sans-serif; font-size: 48px; font-weight: 700; color: #be0000; line-height: 1; }

    /* ── Form inputs ──────────────────────── */
    .form-field { width: 100%; background: transparent; border: 0; border-bottom: 2px solid #2a2d2d; padding: 12px 0; outline: none; font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.1em; color: #e2e2e2; transition: border-color 0.3s; }
    .form-field::placeholder { color: #555; }
    .form-field:focus { border-bottom-color: #be0000; }

    /* ── WhatsApp FAB ─────────────────────── */
    .wa-fab { position: fixed; bottom: 28px; right: 28px; z-index: 100; width: 58px; height: 58px; border-radius: 50%; background: #25d366; display: flex; align-items: center; justify-content: center; box-shadow: 0 6px 24px rgba(37,211,102,0.45); transition: transform 0.2s, box-shadow 0.2s; text-decoration: none; }
    .wa-fab:hover { transform: scale(1.1); box-shadow: 0 10px 32px rgba(37,211,102,0.6); }
    .wa-fab svg { width: 30px; height: 30px; fill: #fff; }

    /* ── Active nav link ─────────────────── */
    .nav-link { position: relative; }
    .nav-link::after { content: ''; position: absolute; bottom: -4px; left: 0; width: 0; height: 2px; background: #be0000; transition: width 0.3s ease; }
    .nav-link.active { color: #e2e2e2 !important; }
    .nav-link.active::after { width: 100%; }

    /* ── Scroll to top button ─────────────── */
    #scroll-top { position: fixed; bottom: 96px; right: 28px; z-index: 100; width: 44px; height: 44px; background: #1a1c1c; border: 1px solid #2a2d2d; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none; opacity: 0; pointer-events: none; transition: opacity 0.3s, border-color 0.2s, background 0.2s, transform 0.2s; }
    #scroll-top.visible { opacity: 1; pointer-events: auto; }
    #scroll-top:hover { border-color: #be0000; background: #be0000; transform: translateY(-2px); }
    #scroll-top svg { width: 18px; height: 18px; fill: #e2e2e2; }

    /* ── Accent elements ─────────────────── */
    .red-line { display: inline-block; width: 60px; height: 3px; background: #be0000; }
    .section-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: #be0000;
      margin-bottom: 14px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }
    .section-label::before {
      content: '';
      display: inline-block;
      width: 28px;
      height: 2px;
      background: #be0000;
      flex-shrink: 0;
    }
    .slash { color: #be0000; font-weight: 900; margin-right: 8px; }
    .about-img-wrap { transition: transform 0.5s ease; }
    .about-img-wrap:hover { transform: rotate(0deg) !important; }

    /* ── Footer ───────────────────────────── */
    .footer-link { font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: #555; transition: color 0.2s; text-decoration: none; }
    .footer-link:hover { color: #be0000; }

    /* ── Mobile nav ───────────────────────── */
    .mobile-nav { font-family: 'Space Grotesk', sans-serif; font-size: 32px; font-weight: 700; color: #e2e2e2; text-decoration: none; letter-spacing: -0.02em; transition: color 0.2s; }
    .mobile-nav:hover { color: #be0000; }

    /* ── Navbar styles ──────────────────── */
    .nb-desk-links   { display: none; }
    .nb-desk-actions { display: none; }
    .nb-mob-actions  { display: flex; align-items: center; gap: 8px; }
    @media (min-width: 1024px) {
      .nb-desk-links   { display: flex; align-items: center; gap: 28px; }
      .nb-desk-actions { display: flex; align-items: center; gap: 10px; }
      .nb-mob-actions  { display: none; }
    }
    #mob-menu { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 10000; background: #0d0f0f; flex-direction: column; align-items: center; justify-content: center; overflow: hidden; }
    #mob-menu.open { display: flex; }
    #mob-menu * { color: inherit; }
    .nb-link { font-family: 'JetBrains Mono', monospace; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: #a0a0a0; text-decoration: none; transition: color 0.2s; }
    .nb-link:hover { color: #e2e2e2; }
    #nb-lang-btn { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: #e2e2e2; background: transparent; border: 1px solid #2a2d2d; padding: 6px 10px; cursor: pointer; display: flex; align-items: center; gap: 5px; transition: border-color 0.2s, color 0.2s; }
    #nb-lang-btn:hover { border-color: #be0000; color: #fff; }
    #nb-hamburger { background: transparent; border: none; cursor: pointer; padding: 6px; display: flex; flex-direction: column; gap: 5px; }
    #nb-hamburger span { display: block; height: 2px; background: #e2e2e2; }
    .mob-link { font-family: 'Space Grotesk', sans-serif; font-size: clamp(24px, 7vw, 40px); font-weight: 700; color: #e2e2e2 !important; text-decoration: none; letter-spacing: -0.02em; padding: 7px 0; text-align: center; transition: color 0.2s; display: block; width: 100%; }
    .mob-link:hover { color: #be0000 !important; }
    .mob-link.active { color: #be0000 !important; }
    .lang-opt { font-family: 'JetBrains Mono', monospace; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; background: transparent; color: #555; border: 1px solid #2a2d2d; padding: 6px 12px; cursor: pointer; text-align: center; transition: color 0.2s, border-color 0.2s, background 0.2s; }
    .lang-opt:hover { color: #e2e2e2; border-color: #be0000; }
    .lang-opt.active { color: #fff; background: #be0000; border-color: #be0000; }

    /* ── Masonry grid ─────────────────────── */
    .masonry-grid { columns: 3; column-gap: 12px; }
    @media (max-width: 900px) { .masonry-grid { columns: 2; } }
    @media (max-width: 500px) { .masonry-grid { columns: 1; } }
    .masonry-item { break-inside: avoid; margin-bottom: 12px; }
    .masonry-item.hidden { display: none; }
    .masonry-grid .port-card { display: block; text-decoration: none; position: relative; overflow: hidden; }
    .masonry-grid .port-card img { width: 100%; height: auto; display: block; transition: transform 0.45s ease; }
    .masonry-grid .port-card:hover img { transform: scale(1.04); }
    .port-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 28px 14px 12px; background: linear-gradient(to top, rgba(13,15,15,0.85), transparent); opacity: 0; transition: opacity 0.3s ease; }
    .masonry-grid .port-card:hover .port-overlay { opacity: 1; }

    /* ── Port filters ────────────────────── */
    .port-filter { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; padding: 10px 24px; border: 1px solid rgba(255,255,255,0.2); background: transparent; color: #a0a0a0; cursor: pointer; transition: border-color 0.2s, color 0.2s, background 0.2s, transform 0.15s; }
    .port-filter:hover  { border-color: #be0000; color: #fff; transform: translateY(-1px); }
    .port-filter.active { border-color: #be0000; background: #be0000; color: #fff; box-shadow: 0 4px 16px rgba(190,0,0,0.35); }

    /* ── Merch cards ─────────────────────── */
    .merch-card { background: #1a1c1c; border: 1px solid #2a2d2d; display: flex; flex-direction: column; transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s; }
    .merch-card:hover { border-color: #be0000; transform: translateY(-4px); box-shadow: 0 12px 32px rgba(190,0,0,0.15); }
    .merch-img-wrap { position: relative; aspect-ratio: 1/1; overflow: hidden; background: #fff; }
    .merch-img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; display: block; }
    .merch-card:hover .merch-img-wrap img { transform: scale(1.05); }
    .merch-badge { position: absolute; top: 10px; right: 10px; font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.12em; text-transform: uppercase; background: #1a1c1c; color: #a0a0a0; padding: 4px 8px; border: 1px solid #2a2d2d; }
    .merch-badge-hot { background: #be0000 !important; color: #fff !important; border-color: #be0000 !important; }
    .merch-info { padding: 18px 16px 20px; display: flex; flex-direction: column; flex: 1; }
    .merch-tag { font-family: 'JetBrains Mono', monospace; font-size: 9px; letter-spacing: 0.15em; text-transform: uppercase; color: #be0000; }
    .merch-title { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 14px; color: #e2e2e2; line-height: 1.3; margin: 6px 0 4px; }
    .merch-desc { font-family: 'Manrope', sans-serif; font-size: 12px; color: #555; margin-bottom: 12px; }
    .merch-price { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 20px; color: #be0000; margin-bottom: 14px; }
    .merch-btn { display: block; text-align: center; text-decoration: none; font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; padding: 10px; border: 1px solid #2a2d2d; color: #a0a0a0; transition: background 0.2s, border-color 0.2s, color 0.2s; margin-top: auto; }
    .merch-btn:hover { background: #be0000; border-color: #be0000; color: #fff; }

    /* ── Portfolio 3-col grid ────────────── */
    .port-grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    @media (max-width: 900px) { .port-grid-3 { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 500px) { .port-grid-3 { grid-template-columns: 1fr; } }
    .port-grid-3 .port-item { overflow: hidden; aspect-ratio: 3/4; }
    .port-grid-3 .port-item.hidden { display: none; }
    .port-grid-3 .port-card { display: block; height: 100%; text-decoration: none; }
    .port-grid-3 .port-card img { width: 100%; height: 100%; object-fit: cover; object-position: center; filter: grayscale(20%); transition: transform 0.55s ease, filter 0.55s ease; }
    .port-grid-3 .port-card:hover img { transform: scale(1.07); filter: grayscale(0); }
    .port-grid-3 .port-card .port-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(190,0,0,0.65) 0%, transparent 55%); opacity: 0; transition: opacity 0.35s ease; display: flex; align-items: flex-end; padding: 18px 14px; }
    .port-grid-3 .port-card:hover .port-overlay { opacity: 1; }
    .port-grid-3 .port-item { position: relative; }

    /* ── GLightbox custom ─────────────────── */
    .glightbox-clean .gslide-description { background: rgba(13,15,15,0.95); }
    .glightbox-clean .gdesc-inner { padding: 14px 20px; }
    .glightbox-clean .gslide-title { font-family: 'Space Grotesk',sans-serif; font-size: 14px; color: #e2e2e2; margin: 0 0 4px; }
    .glightbox-clean .gslide-desc  { font-family: 'JetBrains Mono',monospace; font-size: 11px; letter-spacing: 0.1em; color: #be0000; text-transform: uppercase; }
    .gnext, .gprev { background: rgba(190,0,0,0.8) !important; border-radius: 0 !important; }

    /* Delay helpers */
    .delay-1 { transition-delay: 0.1s; }
    .delay-2 { transition-delay: 0.2s; }
    .delay-3 { transition-delay: 0.3s; }
    .delay-4 { transition-delay: 0.4s; }
    .delay-5 { transition-delay: 0.5s; }
    .delay-6 { transition-delay: 0.6s; }
  </style>
</head>

<body class="noise dark">

  <!-- ═══════════════════════════════════════ -->
  <!-- NAVBAR                                  -->
  <!-- ═══════════════════════════════════════ -->
  <nav id="navbar" style="position:fixed;top:0;width:100%;z-index:400;background:rgba(13,15,15,0.92);backdrop-filter:blur(12px);box-shadow:0 1px 0 rgba(190,0,0,0.15);">
    <div style="max-width:1280px;margin:0 auto;padding:0 24px;height:72px;display:flex;align-items:center;justify-content:space-between;">

      <!-- Logo -->
      <a href="/" style="display:flex;align-items:center;gap:12px;text-decoration:none;flex-shrink:0;">
        <div style="width:40px;height:40px;border-radius:50%;border:2px solid #be0000;overflow:hidden;flex-shrink:0;">
          <img src="/logo-icon.webp" alt="Wayki" style="width:100%;height:100%;object-fit:cover;display:block;" />
        </div>
        <span style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;letter-spacing:-0.02em;color:#e2e2e2;">
          WAYKI <span style="color:#be0000;">TATTOO</span>
        </span>
      </a>

      <!-- Desktop links -->
      <div class="nb-desk-links">
        <a href="/"           class="nb-link nav-link" data-i18n="nav_inicio">Inicio</a>
        <a href="/portafolio" class="nb-link nav-link" data-i18n="nav_portfolio">Portafolio</a>
        <a href="/artistas"   class="nb-link nav-link" data-i18n="nav_artistas">Artistas</a>
