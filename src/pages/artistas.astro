---
import Layout from '../layouts/Layout.astro';
import { getArtistas, urlFor } from '../lib/sanity';

const artistas = await getArtistas();
---

<Layout
  title="Artistas — Wayki Tattoo Studio | Arequipa, Perú"
  description="Conoce al equipo de Wayki Tattoo Studio. Artistas especializados en realismo, color, blackwork, fineline y cover up en Arequipa, Perú. Reserva tu cita."
  url="https://waykitattoostudio.pe/artistas"
  image="https://waykitattoostudio.pe/images/artista_1.webp"
>
  <!-- Header -->
  <div style="background:#121414;padding:120px 0 60px;">
    <div class="max-w-[1280px] mx-auto px-6 md:px-10">
      <span class="section-label" data-i18n="artists_label">Nuestro equipo</span>
      <h1 style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(40px,6vw,72px);letter-spacing:-0.03em;color:#e2e2e2;">
        <span class="slash">/</span><span data-i18n="artists_title">Los Artistas</span>
      </h1>
      <div class="red-line mt-4"></div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════ -->
  <!-- ARTISTAS                                -->
  <!-- ═══════════════════════════════════════ -->
  <section style="background:#121414;padding:48px 0 96px;position:relative;overflow:hidden;">
    <div style="position:absolute;right:0;top:50%;transform:translateY(-50%);pointer-events:none;user-select:none;opacity:0.03;">
      <span style="font-family:'Space Grotesk',sans-serif;font-weight:900;font-size:260px;line-height:1;color:#be0000;white-space:nowrap;">ARTIST</span>
    </div>
    <div class="max-w-[1280px] mx-auto px-6 md:px-10">
      <div class="flex justify-end mb-12">
        <a href="https://wa.me/51993054099?text=Hola!%20Quiero%20consultar%20con%20un%20artista." target="_blank"
           data-wa-msg="wa_artista_cta"
           class="btn-ghost" style="padding:10px 24px;font-size:12px;" data-i18n="artists_cta">
          Consultar disponibilidad ↗
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {artistas.length ? artistas.map((a: any) => (
          <div class="reveal" style="background:#1a1c1c;border:1px solid #2a2d2d;transition:border-color 0.3s,box-shadow 0.3s;" onmouseover="this.style.borderColor='#be0000';this.style.boxShadow='0 12px 40px rgba(190,0,0,0.15)';" onmouseout="this.style.borderColor='#2a2d2d';this.style.boxShadow='none';">
            <div style="position:relative;aspect-ratio:3/4;overflow:hidden;background:#0d0f0f;">
              {a.foto && <img src={urlFor(a.foto).width(600).url()} alt={a.nombre} style="width:100%;height:100%;object-fit:cover;object-position:top;filter:grayscale(20%);transition:transform 0.6s ease,filter 0.6s ease;" onmouseover="this.style.transform='scale(1.04)';this.style.filter='grayscale(0)';" onmouseout="this.style.transform='scale(1)';this.style.filter='grayscale(20)';" />}
              <div style="position:absolute;top:16px;left:16px;background:#be0000;padding:5px 12px;"><span style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:#fff;" data-i18n="artists_badge">Artista</span></div>
            </div>
            <div style="padding:24px 24px 28px;">
              <span style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.2em;text-transform:uppercase;color:#be0000;">WAYKI TATTOO</span>
              <h2 style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:26px;color:#e2e2e2;letter-spacing:-0.02em;margin:8px 0 4px;">{a.nombre}</h2>
              <p style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#555;margin-bottom:16px;">{a.especialidad || 'Realismo · Color · Blackwork'}</p>
              <div style="width:40px;height:2px;background:#be0000;margin-bottom:16px;"></div>
              <p style="font-family:'Manrope',sans-serif;font-size:14px;color:#a0a0a0;line-height:1.7;margin-bottom:20px;">{a.bio}</p>
              <a href={`https://wa.me/51993054099?text=Hola!%20Quiero%20una%20cita%20con%20${encodeURIComponent(a.nombre)}.`} target="_blank" class="btn-primary" style="font-size:11px;padding:10px 20px;" data-i18n="artists_book" data-wa-prefix="wa_artista_prefix" data-wa-suffix={a.nombre}>Reservar</a>
            </div>
          </div>
        )) : (
          <div class="reveal" style="background:#1a1c1c;border:1px solid #2a2d2d;transition:border-color 0.3s,box-shadow 0.3s;" onmouseover="this.style.borderColor='#be0000';this.style.boxShadow='0 12px 40px rgba(190,0,0,0.15)';" onmouseout="this.style.borderColor='#2a2d2d';this.style.boxShadow='none';">
            <div style="position:relative;aspect-ratio:3/4;overflow:hidden;background:#0d0f0f;">
              <img src="/images/artista_1.webp" alt="Angel Sulca — Wayki Tattoo Studio" style="width:100%;height:100%;object-fit:cover;object-position:top;filter:grayscale(20%);transition:transform 0.6s ease,filter 0.6s ease;" onmouseover="this.style.transform='scale(1.04)';this.style.filter='grayscale(0)';" onmouseout="this.style.transform='scale(1)';this.style.filter='grayscale(20)';" />
              <div style="position:absolute;top:16px;left:16px;background:#be0000;padding:5px 12px;"><span style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.18em;text-transform:uppercase;color:#fff;" data-i18n="artists_badge">Artista Principal</span></div>
            </div>
            <div style="padding:24px 24px 28px;">
              <span style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.2em;text-transform:uppercase;color:#be0000;">WAYKI TATTOO</span>
              <h2 style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:26px;color:#e2e2e2;letter-spacing:-0.02em;margin:8px 0 4px;">Angel Sulca</h2>
              <p style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#555;margin-bottom:16px;" data-i18n="artists_specialty">Realismo · Color · Blackwork</p>
              <div style="width:40px;height:2px;background:#be0000;margin-bottom:16px;"></div>
              <p style="font-family:'Manrope',sans-serif;font-size:14px;color:#a0a0a0;line-height:1.7;margin-bottom:20px;" data-i18n="artists_bio">Artista de tatuaje con visión única para el realismo y el color. Cada trazo es un compromiso con la perfección y la identidad del cliente.</p>
              <div style="display:flex;align-items:center;gap:12px;">
                <a href="https://www.instagram.com/waykitattoostudio/" target="_blank" style="display:flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.08em;color:#555;text-decoration:none;text-transform:uppercase;transition:color 0.2s;" onmouseover="this.style.color='#be0000'" onmouseout="this.style.color='#555'"><svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:currentColor;flex-shrink:0;"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>@waykitattoostudio</a>
                <a href="https://wa.me/51993054099?text=Hola!%20Quiero%20una%20cita%20con%20Angel%20Sulca." target="_blank" style="margin-left:auto;display:inline-flex;align-items:center;gap:6px;background:transparent;border:1px solid #2a2d2d;color:#a0a0a0;padding:8px 16px;font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.12em;text-transform:uppercase;text-decoration:none;transition:background 0.2s,border-color 0.2s,color 0.2s;" onmouseover="this.style.background='#be0000';this.style.borderColor='#be0000';this.style.color='#fff';" onmouseout="this.style.background='transparent';this.style.borderColor='#2a2d2d';this.style.color='#a0a0a0';" data-i18n="artists_book" data-wa-prefix="wa_artista_prefix" data-wa-suffix="Angel Sulca">Reservar</a>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </section>
</Layout>
