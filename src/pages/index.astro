---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Wayki Tattoo Studio — Arequipa, Perú | Tatuajes de Alta Calidad"
  description="Estudio de tatuajes premium en Arequipa, Perú. Especialistas en realismo, color, blackwork y fineline. Más de 10 años de experiencia. Est. 2013."
  url="https://waykitattoostudio.pe/"
  image="https://waykitattoostudio.pe/images/og-logo.jpg"
>

  <!-- ═══════════════════════════════════════ -->
  <!-- HERO                                    -->
  <!-- ═══════════════════════════════════════ -->

  <!-- Hero-specific global styles (bypass Astro scoping) -->
  <style is:global>
    .hs-wrap { position: absolute; inset: 0; z-index: 0; overflow: hidden; }
    .hs {
      position: absolute; inset: 0;
      opacity: 0;
      transition: opacity 1.2s ease-in-out;
    }
    .hs.active { opacity: 1; }
    .hs img {
      width: 100%; height: 100%;
      object-fit: cover; object-position: center top;
      display: block;
    }
  </style>

  <section id="inicio" style="position:relative;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0d0f0f;">

    <!-- Slides -->
    <div class="hs-wrap" id="hero-slides">
      <div class="hs active" id="hs-0"><img src="/images/hero/banner_1.jpg" alt="Wayki Tattoo Studio" fetchpriority="high" loading="eager" /></div>
      <div class="hs"        id="hs-1"><img src="/images/hero/banner_2.jpg" alt="Wayki Tattoo Studio" fetchpriority="high" loading="eager" /></div>
      <div class="hs"        id="hs-2"><img src="/images/hero/banner_3.jpg" alt="Wayki Tattoo Studio" fetchpriority="high" loading="eager" /></div>
    </div>

    <!-- Dark gradient overlay -->
    <div style="position:absolute;inset:0;z-index:1;background:linear-gradient(to bottom,rgba(13,15,15,0.25) 0%,rgba(13,15,15,0.10) 30%,rgba(13,15,15,0.55) 70%,rgba(13,15,15,0.95) 100%);pointer-events:none;"></div>

    <!-- Red glow bottom -->
    <div style="position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:600px;height:300px;border-radius:50%;pointer-events:none;z-index:2;background:radial-gradient(ellipse,rgba(201,168,76,0.18) 0%,transparent 70%);"></div>

    <!-- Content -->
    <div style="position:relative;z-index:3;display:flex;flex-direction:column;align-items:center;text-align:center;padding:80px 24px 0;max-width:1000px;margin:0 auto;">
      <div class="reveal" style="width:140px;height:140px;border-radius:50%;border:2px solid rgba(201,168,76,0.5);box-shadow:0 0 60px rgba(201,168,76,0.45);overflow:hidden;margin-bottom:40px;flex-shrink:0;">
        <img src="/logo-icon.webp" alt="Wayki Tattoo Studio Logo"
             style="width:100%;height:100%;object-fit:cover;display:block;" />
      </div>
      <span class="section-label reveal delay-1" data-i18n="hero_eyebrow">Arequipa · Perú · Est. 2013</span>
      <h1 class="reveal delay-2" data-i18n="hero_title"
          style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(48px,8vw,96px);line-height:0.95;letter-spacing:-0.03em;color:#e2e2e2;margin-bottom:24px;">
        EL ARTE SE<br /><span style="color:#C9A84C;">LLEVA EN LA PIEL</span>
      </h1>
      <p class="reveal delay-3 max-w-xl" data-i18n="hero_subtitle"
         style="font-family:'Manrope',sans-serif;font-size:17px;color:#a0a0a0;line-height:1.7;margin-bottom:48px;">
        En la cultura andina, Wayki significa hermano en Quechua; representa la confianza profunda y el apoyo mutuo entre dos personas. Para nosotros, cada tatuaje es ese lazo: una colaboración entre artista y hermano para crear una pieza única. Desde nuestro taller en el corazón de sillar de Arequipa, transformamos esa conexión en arte plástico real, duradero y con identidad.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:16px;justify-content:center;">
        <a href="/portafolio" class="btn-primary" data-i18n="hero_cta1">Ver Portafolio</a>
        <a href="/contacto"   class="btn-ghost"   data-i18n="hero_cta2">Reservar Cita</a>
      </div>
    </div>

    <!-- Slide dots -->
    <div style="position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;gap:10px;z-index:10;" id="hero-dots">
      <button class="hdot active" data-idx="0" aria-label="Slide 1"></button>
      <button class="hdot"        data-idx="1" aria-label="Slide 2"></button>
      <button class="hdot"        data-idx="2" aria-label="Slide 3"></button>
    </div>
  </section>

  <style is:global>
    .hdot {
      width: 8px; height: 8px; border-radius: 50%;
      background: rgba(255,255,255,0.3);
      border: 1px solid rgba(255,255,255,0.5);
      cursor: pointer; padding: 0;
      transition: background 0.4s, transform 0.3s, border-color 0.4s;
    }
    .hdot.active {
      background: #C9A84C;
      border-color: #C9A84C;
      transform: scale(1.5);
    }
  </style>

  <script is:inline>
    (function () {
      var slides  = document.querySelectorAll('.hs');
      var dots    = document.querySelectorAll('.hdot');
      var current = 0;
      var total   = slides.length;

      function goTo(idx) {
        slides[current].classList.remove('active');
        dots[current].classList.remove('active');
        current = (idx + total) % total;
        slides[current].classList.add('active');
        dots[current].classList.add('active');
      }

      // Auto-advance every 4 s
      var timer = setInterval(function () { goTo(current + 1); }, 4000);

      // Dot clicks
      dots.forEach(function (dot) {
        dot.addEventListener('click', function () {
          clearInterval(timer);
          goTo(parseInt(dot.dataset.idx, 10));
          timer = setInterval(function () { goTo(current + 1); }, 4000);
        });
      });
    })();
  </script>

  <!-- ═══════════════════════════════════════ -->
  <!-- SERVICIOS                               -->
  <!-- ═══════════════════════════════════════ -->
  <section id="servicios" class="py-24 md:py-32" style="background:#121414;">
    <div class="max-w-[1280px] mx-auto px-6 md:px-10">
      <div class="mb-16 reveal">
        <span class="section-label" data-i18n="svc_label">Lo que hacemos</span>
        <h2 style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(32px,4vw,48px);letter-spacing:-0.02em;color:#e2e2e2;">
          <span class="slash">/</span><span data-i18n="svc_title">Nuestros Servicios</span>
        </h2>
        <div class="red-line mt-4"></div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="svc-card reveal delay-1">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><path d="M20.71 5.63l-2.34-2.34a1 1 0 0 0-1.41 0l-3.12 3.12-1.41-1.42-1.42 1.42 1.41 1.41L3 17.25V21h3.75l9.88-9.88 1.41 1.41 1.42-1.42-1.42-1.41 3.12-3.12a1 1 0 0 0 .05-1.35zM6.92 19H5v-1.92l9.06-9.06 1.92 1.92z"/></svg></div>
          <h3 data-i18n="svc1_name" style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;color:#e2e2e2;margin-bottom:8px;">Tatuajes</h3>
          <p data-i18n="svc1_desc" style="font-family:'Manrope',sans-serif;font-size:14px;color:#a0a0a0;line-height:1.65;margin-bottom:14px;">Realismo, color, blackwork, fineline, tradicional y más. Cada pieza diseñada a medida para ti.</p>
          <span data-i18n="svc1_tag" style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#C9A84C;">Servicio principal</span>
        </div>
        <div class="svc-card reveal delay-2">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm0-10a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/></svg></div>
          <h3 data-i18n="svc2_name" style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;color:#e2e2e2;margin-bottom:8px;">Piercings</h3>
          <p data-i18n="svc2_desc" style="font-family:'Manrope',sans-serif;font-size:14px;color:#a0a0a0;line-height:1.65;margin-bottom:14px;">Piercings profesionales con materiales de primera calidad. Asesoría completa antes y después.</p>
          <span data-i18n="svc2_tag" style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#C9A84C;">Disponible</span>
        </div>
        <div class="svc-card reveal delay-3">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><path d="M19 3H5a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h3v8a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2v-8h3a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-7 15h-1v-8h1v8zm2 0h-1v-8h1v8zm4-10H6V5h12v3z"/></svg></div>
          <h3 style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;color:#e2e2e2;margin-bottom:8px;">SiVola Ink</h3>
          <p data-i18n="svc3_desc" style="font-family:'Manrope',sans-serif;font-size:14px;color:#a0a0a0;line-height:1.65;margin-bottom:14px;">Nuestra línea de tintas propias. Formuladas para resultados óptimos y longevidad en tu piel.</p>
          <span data-i18n="svc3_tag" style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#C9A84C;">Marca propia</span>
        </div>
        <div class="svc-card reveal delay-4">
          <div class="svc-icon"><svg viewBox="0 0 24 24"><path d="M19 6h-2c0-2.76-2.24-5-5-5S7 3.24 7 6H5c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-7-3c1.66 0 3 1.34 3 3H9c0-1.66 1.34-3 3-3zm0 10c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/></svg></div>
          <h3 data-i18n="svc4_name" style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;color:#e2e2e2;margin-bottom:8px;">Merch</h3>
          <p data-i18n="svc4_desc" style="font-family:'Manrope',sans-serif;font-size:14px;color:#a0a0a0;line-height:1.65;margin-bottom:14px;">Ropa y accesorios exclusivos con la esencia de Wayki. Lleva la cultura del tatuaje más allá de la piel.</p>
          <span data-i18n="svc4_tag" style="font-family:'JetBrains Mono',monospace;font-size:10px;letter-spacing:0.1em;text-transform:uppercase;color:#C9A84C;">Colección disponible</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════ -->
  <!-- CTA STRIP                               -->
  <!-- ═══════════════════════════════════════ -->
  <section style="background:#0d0f0f;padding:80px 0;border-top:1px solid #1a1c1c;">
    <div class="max-w-[1280px] mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="reveal">
        <p style="font-family:'Space Grotesk',sans-serif;font-size:clamp(24px,3.5vw,40px);font-weight:700;letter-spacing:-0.02em;color:#e2e2e2;line-height:1.2;">
          <span data-i18n="port_cta_q">¿Tienes una idea?</span><br/>
          <span style="color:#C9A84C;" data-i18n="port_cta_s">Hagámosla realidad.</span>
        </p>
        <p style="font-family:'Manrope',sans-serif;font-size:15px;color:#555;margin-top:12px;">
          Arequipa, Perú · Est. 2013
        </p>
      </div>
      <div class="reveal delay-2 flex flex-wrap gap-4">
        <a href="/portafolio" class="btn-ghost"   style="padding:14px 36px;">Ver Portafolio</a>
        <a href="/contacto"   class="btn-primary" style="padding:14px 36px;" data-i18n="port_cta_btn">Cotizar</a>
      </div>
    </div>
  </section>

</Layout>
