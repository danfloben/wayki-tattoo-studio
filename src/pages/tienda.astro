---
import Layout from '../layouts/Layout.astro';
import { readdirSync, statSync, readFileSync } from 'fs';
import { join } from 'path';

const IMAGE_EXTS = ['.webp', '.jpg', '.jpeg', '.png'];
const BASE = 'public/images/tienda';

// ── Leer productos de cada categoría ─────────────────────
interface Producto {
  id: string;
  nombre: string;
  descripcion: string;
  precio: string;
  precio_anterior: string;
  imagenes: string[];
}

function readProductos(categoria: string): Producto[] {
  const dir = join(BASE, categoria);
  const productos: Producto[] = [];
  try {
    readdirSync(dir)
      .filter(e => { try { return statSync(join(dir, e)).isDirectory(); } catch { return false; } })
      .sort()
      .forEach(sub => {
        const subDir = join(dir, sub);
        const imgs = readdirSync(subDir)
          .filter(f => IMAGE_EXTS.some(x => f.toLowerCase().endsWith(x)))
          .sort()
          .map(f => `/images/tienda/${categoria}/${sub}/${f}`);
        if (!imgs.length) return;

        // Leer info.json si existe
        let nombre          = sub.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
        let descripcion     = '';
        let precio          = '';
        let precio_anterior = '';
        try {
          const raw  = readFileSync(join(subDir, 'info.json'), 'utf-8');
          const info = JSON.parse(raw);
          nombre          = info.nombre          || nombre;
          descripcion     = info.descripcion     || '';
          precio          = info.precio          || '';
          precio_anterior = info.precio_anterior || '';
        } catch {}

        productos.push({ id: sub, nombre, descripcion, precio, precio_anterior, imagenes: imgs });
      });
  } catch {}
  return productos;
}

const merchProductos  = readProductos('merch');
const supplyProductos = readProductos('supply');
---

<Layout
  title="Tienda — Wayki Tattoo Studio | Merch Exclusivo & Supply Profesional"
  description="Tienda oficial de Wayki Tattoo Studio. Merch exclusivo, cartridges y supply profesional para tatuadores. Arequipa, Perú. Consulta por WhatsApp."
  url="https://waykitattoostudio.pe/tienda/"
  image="https://waykitattoostudio.pe/images/og-tienda.jpg"
>

  <!-- Header -->
  <div style="background:#121414;padding:120px 0 60px;">
    <div class="max-w-[1280px] mx-auto px-6 md:px-10">
      <span class="section-label" data-i18n="tienda_label">Wayki Store</span>
      <h1 style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(40px,6vw,72px);letter-spacing:-0.03em;color:#C8C0B0;">
        <span class="slash">/</span><span data-i18n="tienda_title">Tienda</span>
      </h1>
      <div class="red-line mt-4"></div>
    </div>
  </div>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />

  <section style="background:#0d0f0f;padding:40px 0 96px;">
    <div class="max-w-[1280px] mx-auto px-6 md:px-10">

      <!-- Tabs Merch / Supply -->
      <div style="display:flex;gap:0;margin-bottom:48px;border-bottom:1px solid #1e2020;">
        <button class="tienda-tab active" data-tab="merch"
                style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;padding:14px 32px;background:transparent;border:none;color:#C8C0B0;cursor:pointer;position:relative;transition:color 0.2s;">
          <span data-i18n="tienda_tab_merch">Merch</span>
        </button>
        <button class="tienda-tab" data-tab="supply"
                style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;padding:14px 32px;background:transparent;border:none;color:#555;cursor:pointer;position:relative;transition:color 0.2s;">
          <span data-i18n="tienda_tab_sup">Supply</span>
        </button>
      </div>

      <!-- ── Categoría: Merch ── -->
      <div id="tab-merch" class="tienda-panel">
        {merchProductos.length === 0 ? (
          <p style="font-family:'JetBrains Mono',monospace;font-size:12px;color:#555;text-align:center;padding:48px 0;" data-i18n="tienda_soon">Próximamente...</p>
        ) : (
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px;">
            {merchProductos.map(producto => (
              <div class="tienda-card">
                <!-- Imagen principal con miniaturas -->
                <div style="position:relative;overflow:hidden;border:1px solid #1e2020;background:#121414;">
                  <!-- Imagen grande: primera del producto -->
                  <a href={producto.imagenes[0]} class="glightbox-tienda"
                     data-gallery={`merch-${producto.id}`}
                     data-title="Wayki Tienda"
                     data-description={producto.id.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}
                     style="display:block;text-decoration:none;">
                    <img src={producto.imagenes[0]}
                         alt={`Merch ${producto.id} — Wayki Tattoo Studio`}
                         loading="lazy"
                         style="width:100%;aspect-ratio:1/1;object-fit:cover;display:block;transition:transform 0.5s ease;" />
                  </a>
                  <!-- Links ocultos para las demás imágenes del producto -->
                  {producto.imagenes.slice(1).map((img, i) => (
                    <a href={img} class="glightbox-tienda"
                       data-gallery={`merch-${producto.id}`}
                       data-title="Wayki Tienda"
                       data-description={`${producto.id.replace(/-/g, ' ')} · imagen ${i + 2}`}
                       style="display:none;" />
                  ))}
                  <!-- Badge cantidad de imágenes -->
                  {producto.imagenes.length > 1 && (
                    <span style="position:absolute;top:10px;right:10px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.1em;background:rgba(13,15,15,0.85);color:#9A9080;padding:3px 8px;border:1px solid #2a2d2d;">
                      {producto.imagenes.length} <span data-i18n="tienda_fotos">fotos</span>
                    </span>
                  )}
                </div>
                <!-- Miniaturas -->
                {producto.imagenes.length > 1 && (
                  <div style="display:flex;gap:6px;margin-top:6px;">
                    {producto.imagenes.map((img, i) => (
                      <div style="flex:1;max-width:80px;overflow:hidden;border:1px solid #1e2020;cursor:pointer;"
                           onclick={`document.querySelectorAll('[data-gallery="merch-${producto.id}"]')[${i}].click()`}>
                        <img src={img} alt="" loading="lazy"
                             style="width:100%;aspect-ratio:1/1;object-fit:cover;display:block;filter:grayscale(20%);transition:filter 0.3s;" />
                      </div>
                    ))}
                  </div>
                )}
                <!-- Info -->
                <div style="padding:16px 4px 4px;">
                  <span style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.16em;text-transform:uppercase;color:#C07A20;" data-i18n="tienda_tab_merch">Merch</span>
                  <h3 style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:17px;color:#C8C0B0;margin:6px 0 6px;line-height:1.3;">
                    {producto.nombre}
                  </h3>
                  {producto.descripcion && (
                    <p style="font-family:'Manrope',sans-serif;font-size:13px;color:#9A9080;line-height:1.6;margin:0 0 12px;">{producto.descripcion}</p>
                  )}
                  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:8px;">
                    {producto.precio && (
                      <div style="display:flex;flex-direction:column;gap:2px;">
                        {producto.precio_anterior && (
                          <span style="font-family:'Space Grotesk',sans-serif;font-size:13px;color:#555;text-decoration:line-through;">{producto.precio_anterior}</span>
                        )}
                        <span style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:22px;color:#C07A20;">{producto.precio}</span>
                      </div>
                    )}
                    <a href={`https://wa.me/51993054099?text=Hola%20Wayki!%20Quiero%20consultar%20sobre%20${encodeURIComponent(producto.nombre)}`}
                       target="_blank"
                       data-wa-prefix="wa_tienda_prefix"
                       data-wa-suffix={producto.nombre}
                       style="display:inline-flex;align-items:center;gap:8px;background:#C07A20;color:#fff;padding:10px 20px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;text-decoration:none;transition:background 0.2s;"
                       onmouseover="this.style.background='#930000'" onmouseout="this.style.background='#C07A20'">
                      <span data-i18n="tienda_consultar">Consultar ↗</span>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- ── Categoría: Supply ── -->
      <div id="tab-supply" class="tienda-panel" style="display:none;">
        {supplyProductos.length === 0 ? (
          <p style="font-family:'JetBrains Mono',monospace;font-size:12px;color:#555;text-align:center;padding:48px 0;" data-i18n="tienda_soon">Próximamente...</p>
        ) : (
          <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px;">
            {supplyProductos.map(producto => (
              <div class="tienda-card">
                <div style="position:relative;overflow:hidden;border:1px solid #1e2020;background:#121414;">
                  <a href={producto.imagenes[0]} class="glightbox-tienda"
                     data-gallery={`supply-${producto.id}`}
                     data-title="Wayki Supply"
                     data-description={producto.id.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}
                     style="display:block;text-decoration:none;">
                    <img src={producto.imagenes[0]}
                         alt={`Supply ${producto.id} — Wayki Tattoo Studio`}
                         loading="lazy"
                         style="width:100%;aspect-ratio:1/1;object-fit:cover;display:block;transition:transform 0.5s ease;" />
                  </a>
                  {producto.imagenes.slice(1).map((img, i) => (
                    <a href={img} class="glightbox-tienda"
                       data-gallery={`supply-${producto.id}`}
                       data-title="Wayki Supply"
                       data-description={`${producto.id.replace(/-/g, ' ')} · imagen ${i + 2}`}
                       style="display:none;" />
                  ))}
                  {producto.imagenes.length > 1 && (
                    <span style="position:absolute;top:10px;right:10px;font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.1em;background:rgba(13,15,15,0.85);color:#9A9080;padding:3px 8px;border:1px solid #2a2d2d;">
                      {producto.imagenes.length} <span data-i18n="tienda_fotos">fotos</span>
                    </span>
                  )}
                </div>
                {producto.imagenes.length > 1 && (
                  <div style="display:flex;gap:6px;margin-top:6px;">
                    {producto.imagenes.map((img, i) => (
                      <div style="flex:1;max-width:80px;overflow:hidden;border:1px solid #1e2020;cursor:pointer;"
                           onclick={`document.querySelectorAll('[data-gallery="supply-${producto.id}"]')[${i}].click()`}>
                        <img src={img} alt="" loading="lazy"
                             style="width:100%;aspect-ratio:1/1;object-fit:cover;display:block;filter:grayscale(20%);transition:filter 0.3s;" />
                      </div>
                    ))}
                  </div>
                )}
                <div style="padding:16px 4px 4px;">
                  <span style="font-family:'JetBrains Mono',monospace;font-size:9px;letter-spacing:0.16em;text-transform:uppercase;color:#C07A20;" data-i18n="tienda_tab_sup">Supply</span>
                  <h3 style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:17px;color:#C8C0B0;margin:6px 0 6px;line-height:1.3;">
                    {producto.nombre}
                  </h3>
                  {producto.descripcion && (
                    <p style="font-family:'Manrope',sans-serif;font-size:13px;color:#9A9080;line-height:1.6;margin:0 0 12px;">{producto.descripcion}</p>
                  )}
                  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:8px;">
                    {producto.precio && (
                      <div style="display:flex;flex-direction:column;gap:2px;">
                        {producto.precio_anterior && (
                          <span style="font-family:'Space Grotesk',sans-serif;font-size:13px;color:#555;text-decoration:line-through;">{producto.precio_anterior}</span>
                        )}
                        <span style="font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:22px;color:#C07A20;">{producto.precio}</span>
                      </div>
                    )}
                    <a href={`https://wa.me/51993054099?text=Hola%20Wayki!%20Quiero%20consultar%20sobre%20${encodeURIComponent(producto.nombre)}`}
                       target="_blank"
                       data-wa-prefix="wa_tienda_prefix"
                       data-wa-suffix={producto.nombre}
                       style="display:inline-flex;align-items:center;gap:8px;background:#C07A20;color:#fff;padding:10px 20px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:11px;letter-spacing:0.12em;text-transform:uppercase;text-decoration:none;transition:background 0.2s;"
                       onmouseover="this.style.background='#930000'" onmouseout="this.style.background='#C07A20'">
                      <span data-i18n="tienda_consultar">Consultar ↗</span>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

    </div>
  </section>

  <script is:inline src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
  <script is:inline>
    // Tabs
    document.querySelectorAll('.tienda-tab').forEach(function(btn) {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.tienda-tab').forEach(function(b) {
          b.style.color = '#555';
          b.classList.remove('active');
        });
        document.querySelectorAll('.tienda-panel').forEach(function(p) { p.style.display = 'none'; });
        btn.style.color = '#C8C0B0';
        btn.classList.add('active');
        document.getElementById('tab-' + btn.dataset.tab).style.display = 'block';
        initTiendaLightbox();
      });
    });

    // Lightbox
    var tiendaLightbox;
    function initTiendaLightbox() {
      if (tiendaLightbox) tiendaLightbox.destroy();
      tiendaLightbox = GLightbox({
        selector: '.tienda-panel:not([style*="display:none"]) .glightbox-tienda',
        touchNavigation: true, loop: false, zoomable: true,
        openEffect: 'fade', closeEffect: 'fade',
      });
    }
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(initTiendaLightbox, 100);
    });
  </script>

  <style is:global>
    .tienda-tab.active { color: #C8C0B0 !important; }
    .tienda-tab.active::after {
      content: ''; position: absolute; bottom: -1px; left: 0; right: 0;
      height: 2px; background: #C07A20;
    }
    .tienda-tab { position: relative; }
    .tienda-card { transition: transform 0.3s; }
    .tienda-card:hover { transform: translateY(-4px); }
  </style>

</Layout>
